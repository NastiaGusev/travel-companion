# Copy this file to .env and fill in real values for local dev.
# .env is git-ignored and must never be committed.

JWT_SECRET=generate-a-long-random-string-at-least-32-chars
DB_NAME=travel
DB_USERNAME=travel
DB_PASSWORD=travel
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Which extraction provider ai-service runs (see ai-service/.env.example): stub | gemini
EXTRACTOR_PROVIDER=stub

# Only needed when EXTRACTOR_PROVIDER=gemini (leave unset for the stub):
# LLM_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini-2.5-flash-lite
