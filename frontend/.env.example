# Leave blank for local dev — vite.config.ts proxies /api to VITE_BACKEND_ORIGIN.
# For a production build, set this to the deployed backend's origin
# (must have CORS enabled for this frontend's origin — see README).
VITE_API_BASE_URL=

# Only used by the dev proxy (vite.config.ts), not bundled into the app.
VITE_BACKEND_ORIGIN=http://localhost:8080
